\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Run~A branch-ablation reconstructions. Codes-only (\texttt  {vq\_only}) is noise; continuous-only (\texttt  {vanilla\_only}) already looks almost like the full model --- the continuous branch is doing the heavy lifting here.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:abl}{{4}{8}{Run~A branch-ablation reconstructions. Codes-only (\texttt {vq\_only}) is noise; continuous-only (\texttt {vanilla\_only}) already looks almost like the full model --- the continuous branch is doing the heavy lifting here}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Experiment 6 --- Moving the prior onto the code (Runs~C and D)}{8}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Radially-averaged power of each branch's pixel-space contribution.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:spec}{{5}{9}{Radially-averaged power of each branch's pixel-space contribution}{figure.caption.12}{}}
\newlabel{eq:klc}{{2}{9}{The fix: make the codeword the \emph {center} of the prior}{equation.7.2}{}}
\newlabel{eq:sepc}{{4}{9}{The fix: make the codeword the \emph {center} of the prior}{equation.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Run~C per-location latent $z=z_{\text  {vq}}+z_{\text  {cont}}$ (PCA to 2-D), colored by code, $\bigstar =$ code centers. The code-centered prior produces tight, well-separated clusters sitting on their codewords --- a genuine Gaussian mixture (separability $2.72$, dip $p<10^{-3}$). Contrast Run~A (Fig.~\ref {fig:gmm}a, one blob).}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:gmmC}{{6}{10}{Run~C per-location latent $z=z_{\text {vq}}+z_{\text {cont}}$ (PCA to 2-D), colored by code, $\bigstar =$ code centers. The code-centered prior produces tight, well-separated clusters sitting on their codewords --- a genuine Gaussian mixture (separability $2.72$, dip $p<10^{-3}$). Contrast Run~A (Fig.~\ref {fig:gmm}a, one blob)}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Run~C} latent features projected onto $5$ validation images (PCA$\to $RGB), same column order as Figs.~\ref {fig:featA}--\ref {fig:featB}: original, reconstruction, VQ features, continuous features, summed features, summed PC1.}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:featC}{{7}{11}{\textbf {Run~C} latent features projected onto $5$ validation images (PCA$\to $RGB), same column order as Figs.~\ref {fig:featA}--\ref {fig:featB}: original, reconstruction, VQ features, continuous features, summed features, summed PC1}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Run~C} radially-averaged power of each branch's pixel-space contribution. The codes (red) dominate at all frequencies (they carry the image, $\sim \!1000\times $ the continuous power); the continuous branch (blue) adds only a small correction, relatively stronger at high/fine frequencies --- the clean ``codes carry the image, continuous refines it'' split the mixture wiring is designed to produce.}}{12}{figure.caption.18}\protected@file@percent }
\newlabel{fig:specC}{{8}{12}{\textbf {Run~C} radially-averaged power of each branch's pixel-space contribution. The codes (red) dominate at all frequencies (they carry the image, $\sim \!1000\times $ the continuous power); the continuous branch (blue) adds only a small correction, relatively stronger at high/fine frequencies --- the clean ``codes carry the image, continuous refines it'' split the mixture wiring is designed to produce}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Experiment 7 --- Is the better-organized latent useful downstream?}{12}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Run~D} (code-centered prior, $\beta {=}0.001$) per-location latent, PCA to 2-D, colored by code, $\bigstar =$ code centers. Same well-separated mixture as Run~C (Fig.~\ref {fig:gmmC}) --- just more compact --- but with Run~A-level reconstruction.}}{13}{figure.caption.20}\protected@file@percent }
\newlabel{fig:gmmD}{{9}{13}{\textbf {Run~D} (code-centered prior, $\beta {=}0.001$) per-location latent, PCA to 2-D, colored by code, $\bigstar =$ code centers. Same well-separated mixture as Run~C (Fig.~\ref {fig:gmmC}) --- just more compact --- but with Run~A-level reconstruction}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Linear-probe top-1 accuracy} (left) and \textbf  {retrieval mAP} (right), val-only, frozen features. Bold = best feature per row. The GMM organization (C, D) clearly helps the \emph  {discrete} features (\texttt  {bagcodes}, \texttt  {z\_vq}) for probing.}}{13}{table.caption.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Linear-probe accuracy by feature and model. \texttt  {bagcodes} is the best feature and rises monotonically A$\to $B$\to $C$\to $D; \texttt  {z\_vq} also rises; \texttt  {z\_cont} falls for the code-prior runs. Dashed line = chance.}}{14}{figure.caption.24}\protected@file@percent }
\newlabel{fig:probe}{{10}{14}{Linear-probe accuracy by feature and model. \texttt {bagcodes} is the best feature and rises monotonically A$\to $B$\to $C$\to $D; \texttt {z\_vq} also rises; \texttt {z\_cont} falls for the code-prior runs. Dashed line = chance}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}Experiment 8 --- Adding a perceptual (LPIPS + GAN) objective (Runs C+ and D+)}{15}{section.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Full-model reconstruction on the \textbf  {full val set ($3925$ images)}, same protocol (batch-wise, torchmetrics rFID/KID, AlexNet LPIPS) for all rows including the VAE, VQ-VAE, RAE and VQGAN baselines. The GAN/LPIPS objective is a \textbf  {perceptual} win: \textbf  {rFID drops $\sim $6--8$\times $ and LPIPS $\sim $4$\times $} vs the MSE runs. The VAE/VQ-VAE rows form a complete \emph  {single-branch ablation} (all matched: 8-ch latent, LPIPS+GAN, $200$ ep): \textbf  {VAE} $=$ continuous branch only, \textbf  {VQ-VAE} $=$ discrete branch only. \textbf  {RAE} and \textbf  {VQGAN} are external-recipe models (their own encoder/latent designs), each \emph  {retrained on Imagenette for $200$ epochs} --- reference points rather than the matched single-branch ablation (which is VAE/VQ-VAE). The GAN also \textbf  {erases the $\beta $ gap}: C+ and D+ are essentially identical, though without the GAN D clearly beat C.}}{15}{table.caption.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Matched single-branch baselines on $5$ val images (original / reconstruction). The continuous-only VAE is indistinguishable from the dual model; the codes-only VQ-VAE is softer --- the continuous branch carries the fine detail.}}{16}{figure.caption.28}\protected@file@percent }
\newlabel{fig:vqrecon}{{11}{16}{Matched single-branch baselines on $5$ val images (original / reconstruction). The continuous-only VAE is indistinguishable from the dual model; the codes-only VQ-VAE is softer --- the continuous branch carries the fine detail}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {C+} branch-ablation reconstructions. \texttt  {full} and \texttt  {vq\_only} are crisp and near-identical to the originals (LPIPS $0.043$ / $0.088$); \texttt  {vanilla\_only} is featureless (the codes carry the image). The equivalent D+ figures are in its folder.}}{17}{figure.caption.29}\protected@file@percent }
\newlabel{fig:reconCg}{{12}{17}{\textbf {C+} branch-ablation reconstructions. \texttt {full} and \texttt {vq\_only} are crisp and near-identical to the originals (LPIPS $0.043$ / $0.088$); \texttt {vanilla\_only} is featureless (the codes carry the image). The equivalent D+ figures are in its folder}{figure.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Mixture diagnostics before vs after the GAN. Per-code structure \emph  {strengthens} (separability, silhouette both up), but the aggregate marginal becomes \emph  {smoother} (the global multimodality tests soften).}}{18}{table.caption.31}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Gaussian-mixture diagnostics: plain VQ-VAE vs.\ the matched dual GAN models. The \emph  {geometric} proxies (separability, silhouette) even look \emph  {better} for the VQ-VAE --- but they are inflated by fine tiling of a large-scale latent (its spacing and residual are both $\sim $$3\times $ larger). The one test that directly asks ``are the codewords the mixture \emph  {means}?'' --- the held-out likelihood of a codeword-anchored mixture vs.\ a single Gaussian --- \textbf  {flips sign}: positive for every code-prior dual run, \textbf  {negative for the VQ-VAE}.}}{18}{table.caption.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {C+} per-location latent (PCA 2-D), colored by code. Top codes form tight, well-separated clusters on their centroids (separability $3.04$), but the aggregate (grey) is a smooth central envelope --- so global multimodality tests read as unimodal even though the components are sharp.}}{19}{figure.caption.32}\protected@file@percent }
\newlabel{fig:gmmCg}{{13}{19}{\textbf {C+} per-location latent (PCA 2-D), colored by code. Top codes form tight, well-separated clusters on their centroids (separability $3.04$), but the aggregate (grey) is a smooth central envelope --- so global multimodality tests read as unimodal even though the components are sharp}{figure.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Downstream (frozen features, full val, chance acc $0.107$, mAP $0.100$): plain VQ-VAE vs.\ matched dual D+. The dual model's codes probe better; retrieval is unmoved (as everywhere).}}{19}{table.caption.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Plain VQ-VAE} pre-quantization latent $z_e$ (PCA 2-D), colored by code, $\bigstar =$ code centroids. The codes tile \emph  {one} continuous Gaussian cloud (grey envelope fills the centre, no gaps between components) --- the codeword-anchored mixture is worse than a single Gaussian ($-0.97$), unlike the tight, likelihood-confirmed components of the code-prior dual models (Figs.~\ref {fig:gmmC},~\ref {fig:gmmCg}).}}{20}{figure.caption.35}\protected@file@percent }
\newlabel{fig:gmmVQ}{{14}{20}{\textbf {Plain VQ-VAE} pre-quantization latent $z_e$ (PCA 2-D), colored by code, $\bigstar =$ code centroids. The codes tile \emph {one} continuous Gaussian cloud (grey envelope fills the centre, no gaps between components) --- the codeword-anchored mixture is worse than a single Gaussian ($-0.97$), unlike the tight, likelihood-confirmed components of the code-prior dual models (Figs.~\ref {fig:gmmC},~\ref {fig:gmmCg})}{figure.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Wavelet vs.\ no-wavelet under the perceptual objective (full model, \textbf  {full val, $3925$ images}). The wavelet \emph  {raises} rFID and LPIPS and lowers PSNR/SSIM --- it did not add clean detail.}}{20}{table.caption.38}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Wavelet weakens the Gaussian mixture; at low $\beta $ (D++) it collapses it.}}{21}{table.caption.39}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {D++} (wavelet, $\beta {=}0.001$) per-location latent, PCA 2-D. The high-variance wavelet Delta swamps the codeword spacing (separability $0.83<1$): centroids pile near the centre and the codes smear into one cloud --- the clean mixture of D+ (Fig.~\ref {fig:gmmC}) is lost.}}{21}{figure.caption.40}\protected@file@percent }
\newlabel{fig:gmmDpp}{{15}{21}{\textbf {D++} (wavelet, $\beta {=}0.001$) per-location latent, PCA 2-D. The high-variance wavelet Delta swamps the codeword spacing (separability $0.83<1$): centroids pile near the centre and the codes smear into one cloud --- the clean mixture of D+ (Fig.~\ref {fig:gmmC}) is lost}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Experiment 9 --- Making the codes semantic: cross-view code-invariance (D+CVI)}{21}{section.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces D+ vs.\ D+CVI. CVI perfectly \emph  {preserves} reconstruction and the mixture (as designed), but does \emph  {not} improve the downstream metrics it targeted.}}{22}{table.caption.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Linear-probe accuracy across pipelines. \texttt  {bagcodes}: the GMM lifts A$\to $D ($0.29\!\to \!0.37$), the GAN lifts D$\to $D+ ($0.37\!\to \!0.44$, the biggest jump), and CVI (D+CVI) matches D+ ($0.44$) --- no further gain. (\texttt  {Dgan}=D+, \texttt  {Dcvi}=D+CVI.)}}{23}{figure.caption.45}\protected@file@percent }
\newlabel{fig:cviprobe}{{16}{23}{Linear-probe accuracy across pipelines. \texttt {bagcodes}: the GMM lifts A$\to $D ($0.29\!\to \!0.37$), the GAN lifts D$\to $D+ ($0.37\!\to \!0.44$, the biggest jump), and CVI (D+CVI) matches D+ ($0.44$) --- no further gain. (\texttt {Dgan}=D+, \texttt {Dcvi}=D+CVI.)}{figure.caption.45}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11}Experiment 10 --- Semantic codes without augmentation: masked code modeling (D+MCM)}{23}{section.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces D+ vs.\ D+MCM (all full val). MCM \emph  {perfectly preserves} reconstruction and the mixture (aux head only) and \textbf  {does not collapse the codebook} (unlike CVI), while giving a small, real gain on the discrete code features. The matched VAE's \texttt  {z\_sum} is shown to make the point that the pooled latent is tied across all three --- the dual edge is the codes.}}{24}{table.caption.48}\protected@file@percent }
