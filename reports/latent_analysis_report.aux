\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Run~B} ($\beta {=}0.1$) latent features projected onto the same $5$ validation images (PCA$\to $RGB), same column order. Compare the VQ-features column against Run~A (Fig.~\ref {fig:featA}).}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:featB}{{3}{6}{\textbf {Run~B} ($\beta {=}0.1$) latent features projected onto the same $5$ validation images (PCA$\to $RGB), same column order. Compare the VQ-features column against Run~A (Fig.~\ref {fig:featA})}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Reconstruction quality by branch ablation (MSE-only runs, \textbf  {full val, $3925$ images}). The roles flip between Run~A and Run~B; in \textbf  {Runs~C/D the codes carry almost everything} (\texttt  {vq\_only}$\approx $\texttt  {full}). \textbf  {Run~D} matches Run~A's fidelity, has a clean mixture, \emph  {and} has the best \textbf  {rFID} of the MSE runs. rFID is shown only for \texttt  {full}; adding the GAN drops it to $\sim $$4$ (Exp.~8).}}{7}{table.caption.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Code-intervention reconstruction (SSIM$\uparrow $ / PSNR$\uparrow $ / LPIPS$\downarrow $) and the decomposition of the \texttt  {full}$-$\texttt  {vanilla\_only} gap. \textbf  {The reason the codes ``help'' differs sharply: a DC artifact in Run~A, but genuine per-image information in Runs~B/C/D.}}}{7}{table.caption.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Exp 5.3 --- Which frequencies each branch carries (Fig.~\ref {fig:spec}).}{7}{section*.11}\protected@file@percent }
