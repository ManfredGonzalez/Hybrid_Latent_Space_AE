\@writefile{toc}{\contentsline {part}{VI\hspace  {1em}Verdict}{31}{part.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {16}The overall story}{31}{section.16}\protected@file@percent }
\newlabel{sec:story}{{16}{31}{The overall story}{section.16}{}}
\@writefile{toc}{\contentsline {paragraph}{1. Claim~A is never in doubt; Claim~B is the whole problem.}{31}{section*.54}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. With the standard prior, $\beta $ is the only knob --- and it charges for structure.}{31}{section*.55}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. The code-centered prior breaks the trade-off --- because it changes the prior's \emph  {shape}, not its strength.}{32}{section*.56}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Two controls rule out the alternative explanations --- it really is the prior.}{32}{section*.57}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What the structure is worth (and what it is not).}{33}{section*.58}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Recommendation.}{33}{section*.59}\protected@file@percent }
