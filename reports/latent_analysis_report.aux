\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Full-model reconstruction on the \textbf  {full val set ($3925$ images)}, same protocol (batch-wise, torchmetrics rFID/KID, AlexNet LPIPS) for all rows including the VAE, VQ-VAE, RAE and VQGAN baselines. The GAN/LPIPS objective is a \textbf  {perceptual} win: \textbf  {rFID drops $\sim $6--8$\times $ and LPIPS $\sim $4$\times $} vs the MSE runs. It also \textbf  {flattens the whole $2\times 2$}: A+, B+, C+ and D+ land within $0.2$ rFID of each other, so neither $\beta $ nor the prior costs anything in reconstruction. \textbf  {That flatness has a ceiling}: \textbf  {E+} ($\beta {=}1.0$, one decade past B+) finally \emph  {does} pay, at rFID $4.94$ and LPIPS $0.066$ (\S  \ref {sec:betaceiling}). The VAE/VQ-VAE rows form a complete \emph  {single-branch ablation} (all matched: 8-ch latent, LPIPS+GAN, $200$ ep): \textbf  {VAE} $=$ continuous branch only, \textbf  {VQ-VAE} $=$ discrete branch only. \textbf  {RAE} and \textbf  {VQGAN} are external-recipe models (their own encoder/latent designs), each \emph  {retrained on Imagenette for $200$ epochs} --- reference points rather than the matched single-branch ablation.}}{16}{table.caption.24}\protected@file@percent }
\newlabel{tab:recon}{{6}{16}{Full-model reconstruction on the \textbf {full val set ($3925$ images)}, same protocol (batch-wise, torchmetrics rFID/KID, AlexNet LPIPS) for all rows including the VAE, VQ-VAE, RAE and VQGAN baselines. The GAN/LPIPS objective is a \textbf {perceptual} win: \textbf {rFID drops $\sim $6--8$\times $ and LPIPS $\sim $4$\times $} vs the MSE runs. It also \textbf {flattens the whole $2\times 2$}: A+, B+, C+ and D+ land within $0.2$ rFID of each other, so neither $\beta $ nor the prior costs anything in reconstruction. \textbf {That flatness has a ceiling}: \textbf {E+} ($\beta {=}1.0$, one decade past B+) finally \emph {does} pay, at rFID $4.94$ and LPIPS $0.066$ (\S \ref {sec:betaceiling}). The VAE/VQ-VAE rows form a complete \emph {single-branch ablation} (all matched: 8-ch latent, LPIPS+GAN, $200$ ep): \textbf {VAE} $=$ continuous branch only, \textbf {VQ-VAE} $=$ discrete branch only. \textbf {RAE} and \textbf {VQGAN} are external-recipe models (their own encoder/latent designs), each \emph {retrained on Imagenette for $200$ epochs} --- reference points rather than the matched single-branch ablation}{table.caption.24}{}}
